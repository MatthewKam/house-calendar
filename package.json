{
	"name": "sprig",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Sprig: a family app for kids' growth and a shared family calendar.",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
		"dev:server": "tsx watch server/index.ts",
		"dev:test": "DATA_DIR=data-test ICLOUD_APPLE_ID= ICLOUD_APP_PASSWORD= REMINDERS_MAC= REMINDERS_SHORTCUT= npm run dev",
		"dev:web": "vite",
		"build": "vite build",
		"ios": "vite build && cap sync ios && cap open ios",
		"ios:sync": "vite build && cap sync ios",
		"ios:testflight": "sh deploy/testflight.sh",
		"start": "NODE_ENV=production tsx server/index.ts",
		"test": "vitest run",
		"check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.131.0",
		"@aparajita/capacitor-secure-storage": "8.0.1",
		"@capacitor/android": "8.6.0",
		"@capacitor/app": "8.1.2",
		"@capacitor/browser": "8.0.5",
		"@capacitor/core": "8.6.0",
		"@capacitor/ios": "8.6.0",
		"@capacitor/keyboard": "8.0.6",
		"@capacitor/push-notifications": "8.1.3",
		"@capacitor/status-bar": "8.0.4",
		"@fastify/static": "^10.1.5",
		"@tanstack/react-query": "^5.104.1",
		"better-sqlite3": "^13.0.3",
		"fast-xml-parser": "5.12.0",
		"fastify": "^5.12.7",
		"ffmpeg-static": "^5.3.0",
		"ical.js": "^2.2.1",
		"jose": "^6.2.12",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tsx": "^4.23.15",
		"undici": "7.30.1",
		"web-push": "^3.6.7",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@capacitor/cli": "8.6.0",
		"@eslint/js": "^10.0.1",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26.6.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/web-push": "^3.6.4",
		"@vitejs/plugin-react": "^6.1.2",
		"concurrently": "^10.0.5",
		"eslint": "^10.14.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.14.0",
		"light-my-request": "^6.8.0",
		"prettier": "^3.10.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.3",
		"vitest": "^5.0.3"
	},
	"overrides": {
		"shell-quote": "^1.12.0",
		"fast-uri": "4.2.3",
		"glob": "14.0.3",
		"minimatch": "11.0.3"
	},
	"allowScripts": {
		"better-sqlite3@13.0.3": true,
		"esbuild@0.28.2": true,
		"fsevents@2.3.3": true
	}
}
