# Copy to .env (never commit .env).

# ---- Running ----
# Where the server listens. Localhost only by default; HOST=0.0.0.0 lets phones on your Wi-Fi reach it
# (and the dev web server too), and is what hosting needs.
HOST=
PORT=3000
# NODE_ENV isn't set here: `npm start` sets it to production, and `npm run dev` leaves it unset.

# ---- Signing in (see README "Accounts and households") ----
# Google: an OAuth "Web application" client id from Google Cloud Console. Later, the phone app's
# iOS/Android client ids go in GOOGLE_APP_CLIENT_IDS (comma-separated).
GOOGLE_CLIENT_ID=
GOOGLE_APP_CLIENT_IDS=
# The same client's secret: lets each person connect their Google Calendar (README "Google Calendar").
GOOGLE_CLIENT_SECRET=
# Apple: the Services ID set up for Sign in with Apple on the web; later, the app's bundle id in APPLE_APP_IDS.
APPLE_SERVICE_ID=
APPLE_APP_IDS=
# Email codes through resend.com. Without them, codes are printed in the server's log (development only).
RESEND_API_KEY=
EMAIL_FROM=
# Hosted without resend.com (a trial): 1 prints sign-in codes in the log anyway, to read from `fly logs`.
EMAIL_CODES_IN_LOG=
# Hosted behind the host's HTTPS proxy: 1. Leave empty on your own machine.
TRUST_PROXY=
# Where accounts.db and every household's data live (default: data/).
DATA_DIR=
# The household from before accounts: its database and photos, if not in DATA_DIR (default:
# DATA_DIR/calendar.db and DATA_DIR/photos). Kept so it can be claimed; new setups leave these empty.
DB_PATH=
PHOTOS_DIR=
# The app's address as people reach it, e.g. https://household.example.com (Google returns there).
# Left empty, it's taken from each request, which is fine on your own machine.
PUBLIC_URL=
# Encrypts stored Google tokens: 32 random bytes, base64 (openssl rand -base64 32). Left empty, a key
# file is made in DATA_DIR on first start; keep it with the data, and set this when hosting.
SECRET_KEY=

# Alerts on phones (web push). Left empty, keys are made in DATA_DIR/vapid.json on first start; keep
# that file with the data. When hosting, set both (npx web-push generate-vapid-keys), and a subject:
# an https URL or mailto: the push services can reach you at (it defaults to PUBLIC_URL).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ---- The household from before accounts: sync its iCloud calendars ----
# (Every other household connects iCloud in the app: Settings > Calendars.)
# App-specific password: account.apple.com > Sign-In and Security > App-Specific Passwords.
ICLOUD_APPLE_ID=you@icloud.com
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Optional: lets Claude sort synced events by family member. Event titles and family names are sent
# to the Anthropic API. Create a key at platform.claude.com > API keys.
ANTHROPIC_API_KEY=

# Optional: turns on iCloud Reminders sync through the iPhone Shortcut (see README). Any long random
# text; the Shortcut sends it so only your phones can change the wall's lists.
REMINDERS_TOKEN=

# Optional: drive times to events and "time to leave" alerts. A Google Cloud API key with the
# Routes API enabled (see README "Travel times").
GOOGLE_MAPS_API_KEY=

# Optional, on a Mac running the wall only: sync this Mac's Reminders directly (REMINDERS_MAC=1), or run a
# Reminders Shortcut on it (REMINDERS_SHORTCUT=its name), every few minutes and soon after a wall change.
# (REMINDERS_SHORTCUT_MINUTES, the old name for REMINDERS_MINUTES, still works.)
REMINDERS_MAC=
REMINDERS_SHORTCUT=
REMINDERS_MINUTES=5
